{
  "name": "@meridian/consent",
  "version": "0.3.0",
  "description": "A lightweight consent runtime and auditable GTM governance toolkit for Meridian.",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "gtm",
    "classifier",
    "migration",
    "policy",
    "scanner",
    "docs",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "meridian-consent": "./bin/meridian-consent.js"
  },
  "exports": {
    "./analytics": "./analytics/index.js",
    "./classifier": "./classifier/index.js",
    "./migration": "./migration/index.js",
    "./policy": "./policy/index.js",
    "./scanner": "./scanner/index.js",
    "./registry": "./classifier/providers.v1.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "scan:example": "node bin/meridian-consent.js scan test/fixtures/container.json",
    "check:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "optionalDependencies": {
    "playwright": "^1.62.1"
  }
}
