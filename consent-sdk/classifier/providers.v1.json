{
  "$schema": "./provider-registry.schema.json",
  "schema_version": "1.0",
  "registry_version": "1.0.1",
  "consent_types": [
    "security_storage",
    "functionality_storage",
    "personalization_storage",
    "analytics_storage",
    "ad_storage",
    "ad_user_data",
    "ad_personalization"
  ],
  "providers": [
    {
      "id": "google.analytics.ga4",
      "provider": "Google",
      "product": "Google Analytics 4",
      "purposes": ["analytics", "audience_measurement"],
      "required_consent": ["analytics_storage"],
      "enforcement": "built_in",
      "match": {
        "tag_types": ["gaawe", "gaawc", "googtag"],
        "name_contains": ["ga4", "google analytics"],
        "code_contains": ["gtag('config'", "gtag(\"config\"", "google-analytics.com/g/collect"]
      }
    },
    {
      "id": "google.ads.conversion",
      "provider": "Google",
      "product": "Google Ads Conversion",
      "purposes": ["advertising", "conversion_measurement"],
      "required_consent": ["ad_storage", "ad_user_data"],
      "enforcement": "built_in",
      "match": {
        "tag_types": ["awct"],
        "name_contains": ["google ads conversion", "adwords conversion"],
        "code_contains": ["googleadservices.com/pagead/conversion", "send_to: 'aw-", "send_to:\"aw-"]
      }
    },
    {
      "id": "google.ads.remarketing",
      "provider": "Google",
      "product": "Google Ads Remarketing",
      "purposes": ["advertising", "remarketing", "personalization"],
      "required_consent": ["ad_storage", "ad_user_data", "ad_personalization"],
      "enforcement": "built_in",
      "match": {
        "tag_types": ["sp"],
        "name_contains": ["google ads remarketing", "adwords remarketing"],
        "code_contains": ["googleads.g.doubleclick.net/pagead/viewthroughconversion"]
      }
    },
    {
      "id": "google.floodlight",
      "provider": "Google",
      "product": "Floodlight",
