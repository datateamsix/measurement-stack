      "enforcement": "built_in",
      "match": {
        "tag_types": ["flc", "fls"],
        "name_contains": ["floodlight"],
        "hostnames": ["fls.doubleclick.net", "ad.doubleclick.net"]
      }
    },
    {
      "id": "meta.pixel",
      "provider": "Meta",
      "product": "Meta Pixel",
      "purposes": ["advertising", "audience_measurement", "remarketing"],
      "required_consent": ["ad_storage", "ad_user_data", "ad_personalization"],
